      "id": "dashboard-upload-webhook",
      "name": "Dashboard Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "rkh-v2-dashboard-upload",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "notes": "POST multipart/form-data with the file in binary property data.",
      "notesInFlow": true,
      "webhookId": "722323ba-43d8-4b09-8875-b4e40139cb29"
    },
    {
      "id": "validate-and-create-run",
      "name": "Validate and Create Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary && item.binary.data;\nif (!binary) throw new Error('UPLOAD_BINARY_MISSING');\nconst filename = String(binary.fileName || item.json.body?.filename || 'upload').split(/[\\/]/).pop();\nconst extension = filename.toLowerCase().split('.').pop();\nif (!['csv', 'xlsx', 'xls'].includes(extension)) throw new Error('UNSUPPORTED_FILE_TYPE');\nconst sourceBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst maxBytes = 25000000;\nif (sourceBuffer.length > maxBytes) throw new Error('UPLOAD_TOO_LARGE');\nconst now = new Date();\nconst day = now.toISOString().slice(0, 10).replaceAll('-', '');\nconst stamp = day + '-' + now.toISOString().slice(11, 19).replaceAll(':', '');\nconst runId = 'RKH-' + day + '-' + stamp + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();\nconst run = { run_id: runId, filename, source: 'DASHBOARD_UPLOAD', created_at: now.toISOString(), updated_at: now.toISOString(), status: 'RECEIVED', total_rows: 0, eligible_count: 0, excluded_count: 0, green_count: 0, yellow_count: 0, amber_count: 0, red_count: 0, mapping_confidence: 0, rule_version: 'MAXIMO-MMS-KEYWORD-v1', error_code: '', error_message: '', source_base64: sourceBuffer.toString('base64'), results_json: '', results_csv: '' };\nreturn [{ json: { ...run, response: { run_id: runId, status: 'RECEIVED' } } }];"
      },
      "notes": "Creates the run metadata and binary run snapshot without requiring Code-node filesystem modules.",
      "notesInFlow": true
    },
