    {
      "id": "prepare-results-lookup",
      "name": "Prepare Results Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "jsCode": "const incoming = $('Get Results Webhook').first().json; const run_id = String(incoming.query?.run_id || incoming.run_id || '').replace(/[^A-Za-z0-9_-]/g, ''); if (!run_id) throw new Error('RUN_ID_REQUIRED'); return [{json: {run_id}}];"
      }
    },
    {
      "id": "get-results-row",
      "name": "Get Results Row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "assurance_runs"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "run_id",
              "condition": "eq",
              "keyValue": "={{$json.run_id}}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "orderBy": false
      }
    },
    {
      "id": "prepare-result-artifact",
      "name": "Prepare Result Artifact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "jsCode": "const row = $input.first()?.json; if (!row?.results_json_path) throw new Error('RESULTS_NOT_FOUND'); return [{json: row}];"
      }
    },
    {
      "id": "read-results-json",
      "name": "Read Results JSON",
