        780,
        300
      ],
      "parameters": {
        "jsCode": "const incoming = $('Get Run Webhook').first().json; const run_id = String(incoming.query?.run_id || incoming.run_id || '').replace(/[^A-Za-z0-9_-]/g, ''); if (!run_id) throw new Error('RUN_ID_REQUIRED'); return [{json: {run_id}}];"
      }
