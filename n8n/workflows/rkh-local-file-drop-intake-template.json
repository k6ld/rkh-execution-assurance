{
  "name": "RKH - Local File Drop Intake",
  "nodes": [
    {
      "id": "watch-rkh-intake-folder",
      "name": "Watch RKH Intake Folder",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "parameters": {
        "triggerOn": "folder",
        "path": "C:/RKH/ExecutionAssurance/inbox",
        "events": [
          "add"
        ],
        "options": {
          "awaitWriteFinish": true,
          "followSymlinks": false,
          "ignoreInitial": true,
          "depth": 0,
          "usePolling": false,
          "ignored": "",
          "ignoreMode": "match"
        }
      },
      "notes": "Inactive template. Watch only the protected local inbox; activate after pilot validation.",
      "notesInFlow": true
    },
    {
      "id": "read-intake-file",
      "name": "Read Intake File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{$json.path}}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "notes": "Reads a newly added intake file after its write completes.",
      "notesInFlow": true
    },
    {
      "id": "validate-and-create-run",
      "name": "Validate and Create Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.data;\nif (!binary) throw new Error('UPLOAD_BINARY_MISSING');\nconst filename = String(binary.fileName || item.json.body?.filename || 'upload').split(/[\\/]/).pop();\nconst extension = filename.toLowerCase().split('.').pop();\nif (!['csv', 'xlsx', 'xls'].includes(extension)) throw new Error('UNSUPPORTED_FILE_TYPE');\nconst sourceBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (sourceBuffer.length > 25000000) throw new Error('UPLOAD_TOO_LARGE');\nconst fs = require('fs'); const crypto = require('crypto');\nconst now = new Date(); const day = now.toISOString().slice(0, 10).replaceAll('-', ''); const stamp = now.toISOString().slice(11, 19).replaceAll(':', '');\nconst run_id = 'RKH-' + day + '-' + stamp + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();\nconst runRoot = \"C:/RKH/ExecutionAssurance\" + '/runs/' + run_id; fs.mkdirSync(runRoot, { recursive: true });\nconst intake_path = String(item.json.path || '');\nconst run = { run_id, filename, source: 'FILE_DROP', created_at: now.toISOString(), updated_at: now.toISOString(), retention_due_at: new Date(now.getTime() + 90 * 86400000).toISOString(), status: 'RECEIVED', total_rows: 0, eligible_count: 0, excluded_count: 0, green_count: 0, yellow_count: 0, amber_count: 0, red_count: 0, mapping_confidence: 0, rule_version: 'MAXIMO-MMS-KEYWORD-v1', error_code: '', error_message: '', source_sha256: crypto.createHash('sha256').update(sourceBuffer).digest('hex'), source_bytes: sourceBuffer.length, source_path: runRoot + '/source.' + extension, results_json_path: runRoot + '/results.json', results_csv_path: runRoot + '/results.csv' };\nreturn [{ json: { ...run, intake_path, response: { run_id, status: 'RECEIVED' } }, binary: { data: binary } }];"
      }
    },
    {
      "id": "move-intake-file-to-run",
      "name": "Move Intake File to Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "jsCode": "const fs = require('fs'); const run = $input.first().json; if (!run.intake_path) throw new Error('INTAKE_PATH_MISSING'); fs.renameSync(run.intake_path, run.source_path); return [{json: run}];"
      },
      "notes": "Moves the validated inbox file into its run folder; it is not copied or retained in the inbox.",
      "notesInFlow": true
    },
