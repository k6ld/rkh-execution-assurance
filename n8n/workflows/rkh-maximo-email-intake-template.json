      "name": "Email Intake Webhook Template",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "rkh-v2-maximo-email-intake",
        "responseMode": "lastNode",
        "options": {}
      },
      "notes": "Replace only after RKH IT approves the Outlook/Exchange credential and mailbox policy.",
      "notesInFlow": true,
      "webhookId": "60bb57c1-de7c-4517-8135-d1d68fe68d4a"
