    {
      "id": "validate-email-and-create-run",
      "name": "Validate Email and Create Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nif (!String(item.json.subject || '').toLowerCase().includes('maximo')) throw new Error('EMAIL_SUBJECT_NOT_ALLOWED');\nconst binary = item.binary?.data;\nif (!binary) throw new Error('UPLOAD_BINARY_MISSING');\nconst filename = String(binary.fileName || item.json.body?.filename || 'upload').split(/[\\/]/).pop();\nconst extension = filename.toLowerCase().split('.').pop();\nif (!['csv', 'xlsx', 'xls'].includes(extension)) throw new Error('UNSUPPORTED_FILE_TYPE');\nconst sourceBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (sourceBuffer.length > 25000000) throw new Error('UPLOAD_TOO_LARGE');\nconst fs = require('fs'); const crypto = require('crypto');\nconst now = new Date(); const day = now.toISOString().slice(0, 10).replaceAll('-', ''); const stamp = now.toISOString().slice(11, 19).replaceAll(':', '');\nconst run_id = 'RKH-' + day + '-' + stamp + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();\nconst runRoot = \"C:/RKH/ExecutionAssurance\" + '/runs/' + run_id; fs.mkdirSync(runRoot, { recursive: true });\nconst intake_path = String(item.json.path || '');\nconst run = { run_id, filename, source: 'EMAIL', created_at: now.toISOString(), updated_at: now.toISOString(), retention_due_at: new Date(now.getTime() + 90 * 86400000).toISOString(), status: 'RECEIVED', total_rows: 0, eligible_count: 0, excluded_count: 0, green_count: 0, yellow_count: 0, amber_count: 0, red_count: 0, mapping_confidence: 0, rule_version: 'MAXIMO-MMS-KEYWORD-v1', error_code: '', error_message: '', source_sha256: crypto.createHash('sha256').update(sourceBuffer).digest('hex'), source_bytes: sourceBuffer.length, source_path: runRoot + '/source.' + extension, results_json_path: runRoot + '/results.json', results_csv_path: runRoot + '/results.csv' };\nreturn [{ json: { ...run, intake_path, response: { run_id, status: 'RECEIVED' } }, binary: { data: binary } }];"
      }
    },
