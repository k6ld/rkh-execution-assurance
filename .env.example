# n8n self-hosted environment
RKH_MAX_UPLOAD_BYTES=25000000
RKH_EMAIL_SUBJECT_PATTERN=MAXIMO
RKH_EMAIL_ALLOWED_SENDERS=maintenance@example.com

# Native n8n file nodes use this persistent allowed area on the target container.
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files

# Frontend only: copy frontend/config.js to a deployment-specific config if needed.
# Never place an n8n credential or shared secret in the GitHub Pages repository.
