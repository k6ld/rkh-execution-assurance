# Copy only into the local n8n service environment; do not commit a populated
# environment file or any API key. These settings are for the single-user
# localhost pilot and must be reviewed by RKH IT before production use.
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_RESTRICT_FILE_ACCESS_TO=C:\RKH\ExecutionAssurance
# Required only for the RKH workflow's controlled creation of a per-run folder,
# local hash calculation, and same-volume file-drop move. Do not permit external modules.
NODE_FUNCTION_ALLOW_BUILTIN=fs,crypto
N8N_DATA_TABLES_MAX_SIZE_BYTES=268435456
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
# Failed execution data is retained locally for seven days solely to diagnose
# failures; successful uploads and result bodies are never retained here.
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
